# 帧叙集-app —— 仓库级 .gitignore
#
# 边界：仓库里只放**源**。凡是「构建/同步/签名产物」一律不入库，
# 否则 CI 里 `cap sync` 会把上一轮的产物又塞回 android/，出包体积和签名都跟着漂。

# 构建产物（build:web 生成；CI 自己会跑一遍）
www/

# Pages 部署根（build:web 生成 = www 静态资产 + functions/ 反代，每次重建即可）。
# 🔴 必须忽略：它内含 www 的副本，入库会让「改一处、两处不同步」这类问题
#    在 diff 里看不出来 —— 真正的源是 functions/ 与 js/，不是这个拼装结果。
_pages/
# 一次性探针目录（验证 functions 放置位置用，不是产物也不是源）
_pages_probe/

# Capacitor 平台目录：CI 由 `capacitor add android` 每次重新生成
# （本地那份是为了本机出包用，不入库）
android/

# 出包产物
apk-dist/
dist/

# 依赖
node_modules/

# 本地签名配置：含 keystore 口令，绝不入库（CI 自己生成并固化 keystore）
android/keystore.properties
*.jks

# 自测：**只排除噪音，测试程序本身必须入库**。
#   311 条断言是这个项目最值钱的质量资产之一，整个目录 ignore 掉
#   = 每次 clone 都把它弄丢、CI 也无从复现。真正该剔的是一次性探针、
#   运行日志和截图（7.9MB 里绝大部分是这个）。
_selftest/_*.cjs
_selftest/_*.log
_selftest/_*.out*
_selftest/_audit*/
_selftest/_srv*/
_selftest/*.log
_selftest/*.out.txt
_selftest/shots/
_selftest/ip-*
_selftest/*.png
_selftest/*.jpg
_selftest/*.mp4
work/
*.log

# 本地工具链与个人信息
.workbuddy/
.idea/
.vscode/

# 主题生成物（packs.json 是配置源，生成器产物每次重建即可）
theme/generated/

# 环境变量 / 密钥
.env
.dev.vars
